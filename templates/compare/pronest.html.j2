{% extends "base.html.j2" %}

{% block structured_data %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "RotaryCAM",
        "item": "https://rotarycam.app/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "RotaryCAM vs. Hypertherm ProNest",
        "item": {{ canonical_url | tojson }}
      }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ page.meta_title | tojson }},
    "description": {{ page.meta_description | tojson }},
    "url": {{ canonical_url | tojson }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "RotaryCAM",
      "url": "https://rotarycam.app/"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does RotaryCAM require a Hypertherm plasma cutter or Hypertherm CNC controller?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. RotaryCAM includes 1,025 built-in presets for Hypertherm SYNC, Hypertherm Duramax, and Generic Air Plasma torches (plus CSV chart import/export) and posts G-code for 14 CNC controllers including SimCNC, LinuxCNC QTPlasmaC, Mach3, Mach4, MASSO, Acorn, FireControl, WinCNC, and grblHAL."
        }
      },
      {
        "@type": "Question",
        "name": "Can RotaryCAM import 3D STEP tube assemblies without paid rotary add-on modules?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Direct 3D STEP/IGES import for round pipe, square/rectangular HSS, angle iron, C-channel, I-beam, and bent sticks is built into the core app with zero add-on modules."
        }
      },
      {
        "@type": "Question",
        "name": "How does RotaryCAM handle small holes and tight saddle copes on a perpendicular torch?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "RotaryCAM applies 60% small-hole feedrate rules, synchronous M62/M63 THC corner/void locking, kerf-compensated holding tabs, and dual-curve zero-bevel fishmouth pullback so overhanging walls do not block tube fit-up."
        }
      },
      {
        "@type": "Question",
        "name": "Is RotaryCAM a subscription like ProNest LT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. RotaryCAM is sold as a perpetual offline license ($199 Maker, $399 Pro Shop) activated by a local key file. One year of updates is included, with optional renewals ($59/$99/yr) only if you want future releases."
        }
      },
      {
        "@type": "Question",
        "name": "When is Hypertherm ProNest or ProNest LT the better choice?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ProNest is the stronger fit for high-volume industrial plate shops running Hypertherm XPR, MAXPRO, or HPR systems that depend on certified SureCut True Hole, Rapid Part, multi-head bevel tables, and ERP/MRP inventory integration."
        }
      }
    ]
  }
  </script>
{% endblock %}

{% block main %}
    <section class="docs-hero">
      <div class="container">
        <div class="docs-breadcrumb">
