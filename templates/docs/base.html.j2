<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ page.meta_title }}</title>
  <meta name="description" content="{{ page.meta_description }}" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="docs.css?v={{ css_version }}" />
  <style>
    .site-header { position: sticky; top: 0; z-index: 1000; background: rgba(13, 15, 18, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid #232833; width: 100%; }
    .site-header nav { max-width: 1240px; margin: 0 auto; padding: 0.9rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; }
    .site-header .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700; color: #fff; text-decoration: none; font-family: 'Space Grotesk', sans-serif; white-space: nowrap; flex-shrink: 0; }
    .site-header .brand-tag { font-size: 0.68rem; background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); padding: 2px 6px; border-radius: 4px; letter-spacing: 0.5px; white-space: nowrap; line-height: 1.2; font-family: 'JetBrains Mono', monospace; }
    .site-header .nav-links { display: flex; align-items: center; gap: 0.65rem; }
    .site-header .nav-links a { position: relative; color: #94a3b8; text-decoration: none; font-size: 0.78rem; line-height: 1.2; white-space: nowrap; transition: color 0.15s ease; padding: 0.25rem 0; }
    .site-header .nav-links a:hover { color: #fff; }
    .site-header .nav-links a.active:not(.nav-back-link) { color: #fff; font-weight: 600; }
    .site-header .nav-links a.active:not(.nav-back-link)::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 100%; height: 2px; background: #f59e0b; border-radius: 2px; box-shadow: 0 0 8px rgba(245, 158, 11, 0.22); }
    .site-header .nav-back-link { color: #f59e0b !important; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem; }
    .site-header .nav-cta { display: inline-flex; align-items: center; background: #14171d; border: 1px solid #232833; color: #f1f5f9; padding: 0.42rem 0.85rem; border-radius: 8px; font-size: 0.8rem; line-height: 1.2; text-decoration: none; white-space: nowrap; flex-shrink: 0; transition: all 0.2s ease; }
    .site-header .nav-cta:hover { border-color: #f59e0b; color: #fff; }
    @media (max-width: 1080px) { .site-header .nav-links { display: none; } }
  </style>
</head>
<body>
  <div class="bg-grid" aria-hidden="true"></div>

  <!-- ========================================================================
       NAVIGATION (Generated by scripts/build_docs.py)
       ======================================================================== -->
  <header class="site-header" id="navbar">
    <nav aria-label="Documentation Navigation">
      <a href="../index.html" class="brand" aria-label="RotaryCAM Home">
        <span>RotaryCAM</span>
        <span class="brand-tag">v0.2-BETA</span>
      </a>

      <div class="nav-links">
        <a href="../index.html" class="nav-back-link">← RotaryCAM</a>
        <a href="index.html"{% if page.slug == 'index' %} class="active"{% endif %}>Overview</a>
        {% for t in tutorials %}
        <a href="{{ t.filename }}"{% if page.slug == t.slug %} class="active"{% endif %}>{{ "%02d"|format(t.num) }}. {{ t.nav_short }}</a>
        {% endfor %}
      </div>

      <a href="../index.html#waitlist" class="nav-cta">Request Early Access</a>
    </nav>
  </header>

  <main>
{% block main %}{% endblock %}
  </main>

{% if page.has_lightbox %}
  <!-- Lightbox Modal -->
  <div class="docs-lightbox" id="docsLightbox" role="dialog" aria-modal="true" aria-label="Screenshot Preview">
    <img class="docs-lightbox-img" id="docsLightboxImg" src="" alt="" />
    <div class="docs-lightbox-bar">
      <span id="docsLightboxCaption"></span>
      <button class="docs-lightbox-close" id="docsLightboxClose" type="button">ESC / Click to Close</button>
    </div>
  </div>
{% endif %}

  <!-- ========================================================================
       FOOTER (Generated by scripts/build_docs.py)
       ======================================================================== -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="../index.html" class="brand">
          <span class="brand-icon">R</span>
          <span class="brand-name">RotaryCAM</span>
          <span class="brand-badge">XYZA</span>
        </a>
        <p class="footer-tagline">
          4-Axis Rotary Tube &amp; Pipe CNC Plasma CAM System.<br />
          From STEP assembly to shop-ready G-code in seconds.
        </p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Documentation</h4>
          <a href="index.html">Documentation Overview</a>
          {% for t in tutorials %}
          <a href="{{ t.filename }}">{{ "%02d"|format(t.num) }}. {{ t.footer_label }}</a>
          {% endfor %}
        </div>
        <div class="footer-col">
          <h4>Product</h4>
          <a href="../index.html#showcase">Showcase</a>
          <a href="../index.html#features">Capabilities</a>
          <a href="../index.html#kinematics">4-Axis Kinematics</a>
          <a href="../build-guide.html">Build Your Own Table</a>
        </div>
        <div class="footer-col">
          <h4>Application</h4>
          <a href="https://app.pipecam.info">Launch Web App</a>
          <a href="https://app.pipecam.info">Built-In CAD Fixtures</a>
        </div>
      </div>
    </div>

    <div class="container footer-bottom">
      <span>&copy; 2026 RotaryCAM. Dedicated 4-axis rotary CNC plasma CAM.</span>
      <span class="mono">{{ footer_tech_strip }}</span>
    </div>
  </footer>

{% if page.has_lightbox %}
  <script>
    (function () {
      const lightbox = document.getElementById('docsLightbox');
      const lightboxImg = document.getElementById('docsLightboxImg');
      const lightboxCaption = document.getElementById('docsLightboxCaption');
      const lightboxClose = document.getElementById('docsLightboxClose');

      document.querySelectorAll('.doc-figure').forEach((fig) => {
        const img = fig.querySelector('img');
        const cap = fig.querySelector('.doc-figure-caption');
        const open = () => {
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightboxCaption.textContent = cap ? cap.textContent.trim() : img.alt;
          lightbox.classList.add('open');
        };
        fig.querySelector('.doc-figure-img-wrap').addEventListener('click', open);
        const zoomBtn = fig.querySelector('.doc-figure-zoom');
        if (zoomBtn) zoomBtn.addEventListener('click', open);
      });

      const close = () => lightbox.classList.remove('open');
      lightbox.addEventListener('click', (e) => {
        if (e.target !== lightboxImg) close();
      });
      lightboxClose.addEventListener('click', close);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    })();
  </script>
{% endif %}
</body>
</html>
