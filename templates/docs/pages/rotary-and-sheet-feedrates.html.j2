                  </tr>
                  <tr style="border-bottom: 1px solid var(--border-subtle);">
                    <td style="padding: 0.65rem 0.85rem;"><strong>ArtSoft Mach3 (<code class="mono">R3.043.062</code>)</strong></td>
                    <td style="padding: 0.65rem 0.85rem;">Plate / Round / HSS</td>
