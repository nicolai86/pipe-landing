{% extends "base.html.j2" %}

{% block structured_data %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "RotaryCAM",
        "item": "https://rotarycam.app/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Documentation",
        "item": "https://rotarycam.app/docs/"
      }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "RotaryCAM Documentation and CAM Workflows",
    "description": {{ page.meta_description | tojson }},
    "image": {{ og_image | tojson }},
    "url": {{ canonical_url | tojson }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ canonical_url | tojson }}
    },
    "author": {
      "@type": "Person",
      "name": "Raphael Randschau"
    },
    "publisher": {
      "@type": "Organization",
      "name": "RotaryCAM",
      "url": "https://rotarycam.app/"
    }
  }
  </script>
{% endblock %}

{% block main %}
    <!-- ======================================================================
         DOCUMENTATION HERO
         ====================================================================== -->
    <section class="docs-hero">
      <div class="container">
        <div class="docs-breadcrumb">
          <a href="../">RotaryCAM</a>
          <span class="sep">/</span>
          <span class="current">Documentation &amp; Visual Workflows</span>
        </div>

        <h1 class="docs-title">Operator Guides &amp; <span class="text-gradient-amber">CAM Workflows</span></h1>
        <p class="docs-subtitle">
          Get your rotary plasma table cutting accurate parts faster. Set up your 4-axis tube and chuck limits, dial in zero-bevel saddles and lead-ins, and unfold bent HSS sticks with kerf relief cuts. Nest multi-tube STEP assemblies or DXF/SVG flat sheets with 2-point scaling, then export <code class="mono">G20</code> (in) or <code class="mono">G21</code> (mm) G-code with synced <code class="mono">M62/M63</code> torch control.
        </p>

        <div class="docs-meta-bar">
          <span class="docs-meta-pill amber"><strong>{{ total_tutorials }} Core Workflows</strong> • {{ total_steps }} Documented Steps</span>
          <span class="docs-meta-pill cyan"><strong>Controllers:</strong> Any 4-Axis CNC (G93 / G94) • Native G20 (in) &amp; G21 (mm) • FireControl, WinCNC, Mach4, LinuxCNC</span>
          <span class="docs-meta-pill"><strong>CAD Input:</strong> STEP (.step / .stp) 3D Assemblies &amp; DXF / SVG Flat-Sheet Kits</span>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         TUTORIAL CARDS GRID (Generated from central TUTORIALS registry)
         ====================================================================== -->
    <section class="container">
      <div class="docs-hub-grid">
        {% for t in tutorials %}
        <!-- Guide {{ t.num }}: {{ t.hub_title | safe }} -->
        <a href="{{ t.filename }}" class="docs-hub-card">
          <div class="docs-hub-thumb">
            {% if t.hub_thumb %}
            <picture>
              <source srcset="{{ t.hub_thumb_webp }}" type="image/webp" />
              <img src="{{ t.hub_thumb }}" alt="{{ t.hub_thumb_alt }}" width="{{ t.hub_thumb_width }}" height="{{ t.hub_thumb_height }}" loading="lazy" />
            </picture>
            {% else %}
            {{ t.hub_custom_thumb_html | safe }}
            {% endif %}
            <span class="docs-hub-badge">TUTORIAL {{ "%02d"|format(t.num) }} • {{ t.steps_label | upper }}</span>
          </div>
          <div class="docs-hub-content">
            <h2 class="docs-hub-title">{{ t.hub_title | safe }}</h2>
            <p class="docs-hub-desc">
              {{ t.hub_desc | safe }}
            </p>
            <ul class="docs-hub-topics">
              {% for topic in t.hub_topics %}
              <li>{{ topic | safe }}</li>
              {% endfor %}
            </ul>
            <div class="docs-hub-footer">
              <span>Read Tutorial {{ "%02d"|format(t.num) }}</span>
              <span>{{ t.hub_cta_right }} →</span>
            </div>
          </div>
        </a>
        {% endfor %}
      </div>

      <!-- Quick Reference Callout -->
      <div class="doc-intro-card" style="margin-bottom: 5rem;">
        <h2>First-Time Setup Order</h2>
        <p>
          New to the table? Start with <a href="machine-configuration.html" style="color: var(--amber-400);"><strong>Tutorial 01</strong></a>, then wire <a href="simcnc-motion-sync.html" style="color: var(--cyan-400);"><strong>Tutorial 07</strong></a>. Real motor limits and <code class="mono">ExtTrajSyncOut0/1</code> (<code class="mono">M62/M63 P0/P1</code>) wiring hold steady surface speed on corners, stop THC divots, and run clean 3D ramp lead-ins.
        </p>
        <div class="doc-intro-grid">
          <div class="doc-intro-stat">
            <span class="label">Step 1 • Configure Hardware</span>
            <span class="value"><a href="machine-configuration.html" style="color: var(--amber-400);">01. Machine Profiles</a> &amp; <a href="simcnc-motion-sync.html" style="color: var(--amber-400);">07. SimCNC Sync →</a></span>
          </div>
          <div class="doc-intro-stat">
            <span class="label">Step 2 • Tune Contours &amp; Bends</span>
            <span class="value"><a href="cut-path-configuration.html" style="color: var(--cyan-400);">02. Cut Paths</a> &amp; <a href="bending.html" style="color: var(--cyan-400);">04. Bending →</a></span>
          </div>
          <div class="doc-intro-stat">
            <span class="label">Step 3 • CAD, Sticks &amp; Flat Sheets</span>
            <span class="value"><a href="nesting.html" style="color: var(--emerald-400);">03. Nesting</a> &amp; <a href="dxf-svg-flat-sheet.html" style="color: var(--emerald-400);">10. DXF/SVG Flat Sheets →</a></span>
          </div>
        </div>
      </div>
    </section>
{% endblock %}
